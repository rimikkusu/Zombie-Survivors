    {
      "number": 7,
      "title": "Aplicarea alegerii și continuarea meniurilor",
      "context": "LevelUpController.Choose()",
      "parts": [
        {
          "file": "UI/GameUI.cs",
          "start": 165,
          "end": 179,
          "lines": [
            "public bool Choose(int index, bool infiniteXp)",
            "{",
            "    if (screens.State != GameState.LevelUp || session.PendingLevels.Count == 0 ||",
            "        index < 0 || index >= upgradeChoices.Count)",
            "        return false;",
            "    session.Upgrades.ApplyUpgrade(upgradeChoices[index], session.Player);",
            "    session.PendingLevels.Dequeue();",
            "    if (infiniteXp)",
            "        session.GrantNextLevel();",
            "    hud.UpdateHealth();",
            "    hud.UpdateExperience();",
            "    hud.UpdateUpgrades();",
            "    ShowNext();",
            "    return true;",
            "}"
          ],
          "original": "        public bool Choose(int index, bool infiniteXp)\n        {\n            if (screens.State != GameState.LevelUp || session.PendingLevels.Count == 0 ||\n                index < 0 || index >= upgradeChoices.Count)\n                return false;\n            session.Upgrades.ApplyUpgrade(upgradeChoices[index], session.Player);\n            session.PendingLevels.Dequeue();\n            if (infiniteXp)\n                session.GrantNextLevel();\n            hud.UpdateHealth();\n            hud.UpdateExperience();\n            hud.UpdateUpgrades();\n            ShowNext();\n            return true;\n        }"
        }

          "lines": [
            "private static void UpdateBar(Panel fill, int value, int maximum)",
            "{",
            "    // Resize only the fill panel; the labels stay above the bar.",
            "    float fraction = maximum > 0 ? value / (float)maximum : 0f;",
            "    fraction = Math.Clamp(fraction, 0f, 1f);",
            "    fill.Width = (int)(fill.Parent!.ClientSize.Width * fraction);",
            "}"
          ],
          "original": "        private static void UpdateBar(Panel fill, int value, int maximum)\n        {\n            // Resize only the fill panel; the labels stay above the bar.\n            float fraction = maximum > 0 ? value / (float)maximum : 0f;\n            fraction = Math.Clamp(fraction, 0f, 1f);\n            fill.Width = (int)(fill.Parent!.ClientSize.Width * fraction);\n        }"
        }
      ],

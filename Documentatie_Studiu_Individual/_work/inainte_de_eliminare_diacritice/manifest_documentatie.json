            "public PointF GetMovementDirection()",
            "{",
            "    float x = (keysDown.Contains(Keys.D) ? 1 : 0) - (keysDown.Contains(Keys.A) ? 1 : 0);",
            "    float y = (keysDown.Contains(Keys.S) ? 1 : 0) - (keysDown.Contains(Keys.W) ? 1 : 0);",
            "    // Normalize diagonals so they move at the same speed as straight lines.",
            "    if (x != 0 && y != 0)",
            "        return new PointF(x * 0.7071f, y * 0.7071f);",
            "    return new PointF(x, y);",
            "}",
            ""
          ],
          "original": "        public PointF GetMovementDirection()\n        {\n            float x = (keysDown.Contains(Keys.D) ? 1 : 0) - (keysDown.Contains(Keys.A) ? 1 : 0);\n            float y = (keysDown.Contains(Keys.S) ? 1 : 0) - (keysDown.Contains(Keys.W) ? 1 : 0);\n            // Normalize diagonals so they move at the same speed as straight lines.\n            if (x != 0 && y != 0)\n                return new PointF(x * 0.7071f, y * 0.7071f);\n            return new PointF(x, y);\n        }\n"
        }
      ],

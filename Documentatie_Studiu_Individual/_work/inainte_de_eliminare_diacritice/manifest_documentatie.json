          ],
          "original": "        private void RestartGame()\n        {\n            // The form may finish maximizing after the session was created.\n            session.Resize(ClientSize);\n            session.Reset();\n            gameInput.Reset();\n            screens.SetPlaying();\n            hud.UpdateHealth();\n            hud.UpdateExperience();\n            hud.UpdateUpgrades();\n            hud.UpdateWave();\n            debug.UpdateInfo();\n            Invalidate();\n        }\n"

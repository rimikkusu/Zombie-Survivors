    {
      "number": 4,
      "title": "Calculul progresului în Player",
      "context": "Player.AddExperience()",
      "parts": [
        {
          "file": "Game/Entities.cs",
          "start": 158,
          "end": 176,
          "lines": [
            "public int AddExperience(int amount)",
            "{",
            "    if (amount <= 0 || IsDead)",
            "        return 0;",
            "",
            "    Experience += amount;",
            "    int levelsGained = 0;",
            "",
            "    // Keep leftover XP, even if one reward gains several levels.",
            "    while (Experience >= ExperienceToNextLevel)",
            "    {",
            "        Experience -= ExperienceToNextLevel;",
            "        Level++;",
            "        ExperienceToNextLevel += 8;",
            "        levelsGained++;",
            "    }",
            "",
            "    return levelsGained;",
            "}"
          ],
          "original": "        public int AddExperience(int amount)\n        {\n            if (amount <= 0 || IsDead)\n                return 0;\n\n            Experience += amount;\n            int levelsGained = 0;\n\n            // Keep leftover XP, even if one reward gains several levels.\n            while (Experience >= ExperienceToNextLevel)\n            {\n                Experience -= ExperienceToNextLevel;\n                Level++;\n                ExperienceToNextLevel += 8;\n                levelsGained++;\n            }\n\n            return levelsGained;\n        }"
        }
      ],
      "page": 15,
      "code_page": 15

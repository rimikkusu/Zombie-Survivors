            "    session.Resize(ClientSize);",
            "    session.Reset();",
            "    gameInput.Reset();",
            "    screens.SetPlaying();",
            "    hud.UpdateHealth();",
            "    hud.UpdateExperience();",
            "    hud.UpdateUpgrades();",
            "    hud.UpdateWave();",
            "    debug.UpdateInfo();",
            "    Invalidate();",
            "}",
